rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * KEYLO.AI SECURITY RULES
     *
     * CORE PHILOSOPHY:
     * This ruleset enforces a strict user-ownership model. Every piece of user-generated data, 
     * from chat history to AI memory, is architecturally nested under the user's unique 
     * identity path. This ensures that authorization is tied directly to authentication 
     * state and path wildcards, providing a high degree of privacy and performance.
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isImmutable(fieldName) {
      return request.resource.data[fieldName] == resource.data[fieldName];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && (request.resource.data.id == userId || !('id' in request.resource.data));
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * Sub-documents for Profile, Usage, and Memory.
       */
      match /profile/{docId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      match /usage/{docId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if false;
      }

      /**
       * Direct Messages Subcollection
       * Used for the primary chat experience.
       */
      match /messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
      }

      /**
       * Conversation-based hierarchy
       */
      match /conversations/{conversationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);

        match /messages/{messageId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }
      }

      match /aiChatMemory/{docId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if false;
      }
    }

    match /appEvents/{eventId} {
      allow get, list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }
  }
}